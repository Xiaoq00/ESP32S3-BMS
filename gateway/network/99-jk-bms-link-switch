#!/bin/sh
# ============================================================================
# JK-BMS 小主机网络自动切换器（NetworkManager dispatcher 快路径）
# ============================================================================
#
# 【这个文件只做一件事】把 NetworkManager 的网卡事件转交给对账脚本。
#
# 真正的判断逻辑全部在 /usr/local/sbin/jk-bms-link-reconcile.sh 里，
# 本文件保持"薄"，避免逻辑分散在两处、以后维护时改漏一边。
#
# 【历史教训 —— 2026-09-14 故障复盘】
# 旧版本在这里直接写了 `nmcli radio wifi off`，且只在 eth0 的 up/down 事件触发。
# 射频开关是「有记忆」的持久化状态，会被写进 NetworkManager.state，重启后仍为关闭；
# 而开机时若网线本来就插着，eth0 不产生 up 事件，脚本永远不运行，
# 于是没有任何代码执行 `nmcli radio wifi on` —— WiFi 再也无法自动打开。
#
# 结论：事件驱动只能负责"快"，正确性必须由幂等的定时对账保证。
# 详见 jk-bms-link-reconcile.sh 顶部注释。
#
# 【安装位置】/etc/NetworkManager/dispatcher.d/99-jk-bms-link-switch
# 【调用约定】NetworkManager 传入两个参数：$1=网卡名  $2=动作(up/down/vpn-up...)
# ============================================================================

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

RECONCILE=/usr/local/sbin/jk-bms-link-reconcile.sh

IFACE="$1"
ACTION="$2"

# 只关心实体网卡 eth0 的 up / down；其余事件（vpn、dhcp4-change 等）一律忽略。
case "$IFACE:$ACTION" in
    eth0:up|eth0:down)
        [ -x "$RECONCILE" ] && "$RECONCILE"
        ;;
    *)
        exit 0
        ;;
esac

exit 0
